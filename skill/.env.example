# The minted `.skill` ships a real `.env` baked by the Worker at download time.
# This example is only for manual setup / reference. Values come from the
# console: GET /api/me/skill bakes them in for you.
API_BASE=https://your-worker.example.workers.dev
API_KEY=stashk_replace-with-your-derived-key
USER_EMAIL=you@example.com
